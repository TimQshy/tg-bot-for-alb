# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Any random string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose
# Required: verifies incoming webhook calls are really from Meta (App Dashboard → Basic Settings)
WHATSAPP_APP_SECRET=your_app_secret

DATABASE_URL=postgresql://user:password@localhost:5432/beauty_salon

# Admin web panel (/admin) — single account, no username
ADMIN_PASSWORD=choose_a_strong_password
# Random long string, used to sign the admin login cookie — e.g. `openssl rand -hex 32`
ADMIN_COOKIE_SECRET=change_me_to_a_random_string

# Admin phone numbers (digits only, no +, no spaces), comma-separated.
# They get a WhatsApp message + cancel button for every new booking.
ADMIN_PHONES=79161234567

# Salon timezone (used for slot generation and display)
TIMEZONE=Europe/Moscow

# AI FAQ consultant — Gemini Flash primary, DeepSeek fallback on rate-limit.
# Either can be left unset; askAI() just skips a missing provider.
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Minutes a waitlist offer stays open before moving to the next person in line.
# TODO: confirm the real value with the client (see IMPLEMENTATION_PLAN.md, эпик C)
WAITLIST_OFFER_TIMEOUT_MIN=30

PORT=3000
