# One of these per salon — see env/ on the VPS. Each salon runs its own
# container against its own database; nginx routes /s/<slug>/ to it.

# WhatsApp connects as a linked device (Baileys, WhatsApp Web protocol) —
# no Meta app/token needed. First run: open the salon in the admin panel and
# scan the QR from WhatsApp → Настройки → Связанные устройства.
# Session is stored in Postgres (wa_auth table), survives redeploys.

DATABASE_URL=postgresql://salon_arina:password@postgres:5432/salon_arina

# Salon identity. SALON_SLUG must match the key in public/salons.json, the
# nginx /s/<slug>/ location, and the slugs in a Clerk user's publicMetadata.
SALON_SLUG=arina

# Admin panel auth — Clerk. Same instance (so same key) for every salon;
# access is decided per salon from the user's publicMetadata.
CLERK_SECRET_KEY=sk_test_...

# Admin phone numbers (digits only, no +, no spaces), comma-separated.
# They get a WhatsApp message for every new booking; reply "cancel <id>" to cancel it.
ADMIN_PHONES=996555123456

# Salon timezone (used for slot generation and display)
TIMEZONE=Asia/Bishkek

# AI FAQ consultant — DeepSeek. Can be left unset; askAI() then returns null
# and the bot falls back to the main menu.
#
# Issue a separate key per salon and name it in DeepSeek exactly as the salon
# slug: their usage dashboard filters by API key and by day, which is the
# whole per-salon cost breakdown — so we don't track spend ourselves.
DEEPSEEK_API_KEY=your_deepseek_api_key

# Minutes a waitlist offer stays open before moving to the next person in line.
WAITLIST_OFFER_TIMEOUT_MIN=30

PORT=3000
