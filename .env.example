# WhatsApp connects as a linked device (Baileys, WhatsApp Web protocol) —
# no Meta app/token needed. First run: open /admin/wa-qr and scan it from
# WhatsApp → Настройки → Связанные устройства → Привязать устройство.
# Session is stored in Postgres (wa_auth table), survives redeploys.

DATABASE_URL=postgresql://user:password@localhost:5432/beauty_salon

# Admin web panel (/admin) — single account, no username
ADMIN_PASSWORD=choose_a_strong_password
# Random long string, used to sign the admin login cookie — e.g. `openssl rand -hex 32`
ADMIN_COOKIE_SECRET=change_me_to_a_random_string

# Admin phone numbers (digits only, no +, no spaces), comma-separated.
# They get a WhatsApp message for every new booking; reply "cancel <id>" to cancel it.
ADMIN_PHONES=79161234567

# Salon timezone (used for slot generation and display)
TIMEZONE=Europe/Moscow

# AI FAQ consultant — Gemini Flash primary, DeepSeek fallback on rate-limit.
# Either can be left unset; askAI() just skips a missing provider.
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Minutes a waitlist offer stays open before moving to the next person in line.
WAITLIST_OFFER_TIMEOUT_MIN=30

PORT=3000
